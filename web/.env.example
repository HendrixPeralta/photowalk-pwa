# Server settings. On Vercel these are set in the project (the Neon
# integration adds the DATABASE_URL pair). Locally, `vercel env pull .env.local`
# fetches them; or copy this file to .env.local and fill it in.
# Without them the app still builds, and the API answers 503.

# Neon Postgres. The pooled URL serves requests, the unpooled one migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth. The secret signs session cookies: `openssl rand -base64 32`.
# The URL is where this app is served: http://localhost:3000 locally.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google OAuth client (Google Cloud Console, Credentials, Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Walk Partners room photos: a private Vercel Blob store connected to the
# project (Storage, Blob, Private) sets BLOB_STORE_ID, and on Vercel the SDK
# signs in with the deployment's OIDC token. Locally, `vercel env pull`
# brings a VERCEL_OIDC_TOKEN that lasts 12 hours, or set a read-write token.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Vercel Cron sends this with the daily room clean-up (web/vercel.json).
# Production only: `openssl rand -base64 32`.
CRON_SECRET=
