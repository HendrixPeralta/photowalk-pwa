{
  "name": "photoeye-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "NEXT_OUTPUT=export next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p src/worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsx scripts/check-copy.mts && tsx scripts/check-i18n.mts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check && npm run build && npm run build:static",
    "e2e": "playwright test",
    "shots": "tsx scripts/shots.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@serwist/window": "^9.5.13",
    "@vercel/blob": "^2.8.1",
    "@vercel/functions": "^3.9.11",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "immer": "^11.1.21",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@serwist/turbopack": "^9.5.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.5",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.1",
    "jsqr": "^1.4.0",
    "serwist": "^9.5.13",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
